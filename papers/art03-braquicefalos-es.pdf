<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Transporte a√©reo de perros braquic√©falos: riesgos fisiol√≥gicos, factores de riesgo y marco regulatorio</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objetivo. Analizar los riesgos fisiologicos especificos del transporte aereo en perros braquicefalos, los factores individuales que modulan el riesgo y el marco regulatorio de aerolineas e instituciones internacionales. Metodo. Revision tecnica de la anatomia del sindrome obstructivo braquicefalo (BOAS), la fisiologia respiratoria en entorno aeronautico (presion de cabina, PO2, termorregulacion y jadeo), analisis comparativo cabina vs bodega, politicas operativas de aerolineas principales (2024-</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>es</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>braquicefalos, BOAS, transporte aereo, hipoxia hipobara, termorregulacion, jadeo, IATA, DOT, FAA, evaluacion prevuelo</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20370359</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
<?xpacket end='w'?>

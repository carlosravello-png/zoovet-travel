      xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>SAG Chile and pet importation from Peru: the most regulated Latin American destination</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia; Carlos Eduardo Ravello Joo</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>&lt;b&gt;Background.&lt;/b&gt; Chile maintains privileged zoo-sanitary status (rabies-free in domestic continental fauna) actively protected through import controls at all entry points. &lt;b&gt;Objective.&lt;/b&gt; To describe SAG technical requirements for importing dogs and cats from Peru. &lt;b&gt;Results.&lt;/b&gt; The process requires an ISO 11784/11785 microchip, current rabies vaccination, internal and external anti-parasitic treatment within 10 days before entry, and an export health certificate issued and endorsed by SEN</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>SAG Chile, pet importation Chile, export health certificate, SENASA, Tacna-Arica border, anti-parasitic, ISO microchip</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-15</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20210986</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>

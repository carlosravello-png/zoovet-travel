<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Physiologie hypobare dans le transport a√©rien du chien et du chat : pressurisation, oxyg√®ne et r√©ponse physiologique en vol commercial</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objectif. Analyser les mecanismes de compensation physiologique et les limites de reserve face a l'hypoxie moderee chez les canides et felides pendant le transport aerien commercial. Methode. Revue technique de la physiologie respiratoire comparee, des principes de physique des gaz (loi de Boyle, loi de Dalton), des reglementations FAA/EASA/LAR sur la pressurisation de cabine et des donnees disponibles sur la reponse physiologique en vol. Resultats. La pressurisation de cabine commerciale equiva</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>fr</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>hypoxie moderee, transport aerien animaux, brachycephales, pressurisation cabine, PiO2, physiologie respiratoire comparee, FAA, EASA, bien-etre animal en vol</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20361607</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>

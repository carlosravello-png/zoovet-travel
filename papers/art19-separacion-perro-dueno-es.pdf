<?xpacket begin='ï»¿' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>La díada perro–propietario en el transporte aéreo en bodega: el humano como fuente del estrés, el perro como agente emocional, y el desajuste entre riesgo percibido y observado</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Carlos Eduardo Ravello Joo</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objetivo. Sostener que las consecuencias emocionales y fisiologicas del transporte aereo en bodega no se explican por el compartimento presurizado, sino por una diada acoplada en la que el humano es la fuente del estres y el perro, tras milenios de domesticacion, actua como su agente emocional. Metodo. Nota tecnica interdisciplinaria que integra datos oficiales de incidentes (US DOT, 2025), fisiologia comparada del estres (ejes HPA y simpatico-adrenomedular), evidencia de transmision emocional h</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>es</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>diada perro-humano, agente emocional, transmision emocional humano-perro, riesgo percibido vs observado, eje HPA, sincronia de cortisol, quimioseñales, transporte aereo en bodega, bienestar animal</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-07-18</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.21424713</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
<?xpacket end='w'?>
endstream

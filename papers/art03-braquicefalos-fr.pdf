<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Transport a√©rien des chiens brachyc√©phales : risques physiologiques, facteurs de risque et cadre r√©glementaire</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objectif. Analyser les risques physiologiques specifiques du transport aerien chez les chiens brachycephales, les facteurs individuels qui modulent le risque et le cadre reglementaire des compagnies aeriennes et des institutions internationales. Methode. Revue technique de l'anatomie du syndrome obstructif brachycephale (BOAS), de la physiologie respiratoire en environnement aeronautique (pression de cabine, PO2, thermoregulation et hal√®tement), analyse comparative cabine vs soute, politiques op</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>fr</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>brachycephales, BOAS, transport aerien, hypoxie hypobare, thermoregulation, hal√®tement, IATA, DOT, FAA, evaluation prevol</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20370359</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>

<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Hypobaric physiology in air transport of dogs and cats: pressurization, oxygen and physiological response in commercial flight</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objective. To analyze the physiological compensation mechanisms and reserve limits in the face of moderate hypoxia in canids and felids during commercial air transport. Method. Technical review of comparative respiratory physiology, gas physics principles (Boyle's Law, Dalton's Law), FAA/EASA/LAR regulations on cabin pressurization, and available evidence on in-flight physiological response. Results. Commercial cabin pressurization equivalent to 6,000-8,000 feet reduces PiO2 to 15.1-17.1 kPa. Ca</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>moderate hypoxia, pet air transport, brachycephalic, cabin pressurization, PiO2, comparative respiratory physiology, FAA, EASA, animal welfare in flight</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20361607</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>

<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Air transport of brachycephalic dogs: physiological risks, risk factors and regulatory framework</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objective. To analyze the specific physiological risks of air transport in brachycephalic dogs, the individual factors that modulate risk, and the regulatory framework from airlines and international institutions. Method. Technical review of brachycephalic obstructive airway syndrome (BOAS) anatomy, respiratory physiology in the aeronautical environment (cabin pressure, PO2, thermoregulation and panting), comparative cabin vs hold analysis, major airline operational policies (2024-2025), IATA LA</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>brachycephalic, BOAS, air transport, hypobaric hypoxia, thermoregulation, panting, IATA, DOT, FAA, pre-flight assessment</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20370359</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
<?xpacket end='w'?>

<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>The Gut‚ÄìBrain Axis in Dogs and Cats During International Transport: Neuroendocrine Integration, Microbiota and Energy Metabolism</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objective. To integrate mechanistic evidence on the gut-brain axis in canids and felids subjected to international transport, with emphasis on neuroendocrine activation, microbiota changes and energy metabolism alterations. Method. Technical review of published literature on the HPA axis, sympathoadrenomedullary (SAM) system, stress-induced dysbiosis, tight junction permeability, secretory IgA, feline hepatic lipidosis and psychobiotics, integrating rodent models and direct studies in dogs and c</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>en</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>gut-brain axis, dogs, cats, international transport, microbiota, neuroendocrine stress, HPA, dysbiosis, hepatic lipidosis, psychobiotics</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20370344</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>

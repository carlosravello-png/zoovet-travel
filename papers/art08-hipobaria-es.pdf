<?xpacket begin='√Ø¬ª¬ø' id='W5M0MpCehiHzreSzNTczkc9d'?>
<x:xmpmeta xmlns:x='adobe:ns:meta/'>
  <rdf:RDF xmlns:rdf='http://www.w3.org/1999/02/22-rdf-syntax-ns#'
           xmlns:dc='http://purl.org/dc/elements/1.1/'
           xmlns:xmp='http://ns.adobe.com/xap/1.0/'
           xmlns:prism='http://prismstandard.org/namespaces/basic/2.0/'>
    <rdf:Description rdf:about=''>
      <dc:title><rdf:Alt><rdf:li xml:lang='x-default'>Fisiolog√≠a hipob√°rica en el transporte a√©reo de perros y gatos: presurizaci√≥n, ox√≠geno y respuesta fisiol√≥gica en vuelo comercial</rdf:li></rdf:Alt></dc:title>
      <dc:creator><rdf:Seq><rdf:li>Jessica Ysabel Camacho Garcia ; Victor Jesus Camacho Paz</rdf:li></rdf:Seq></dc:creator>
      <dc:description><rdf:Alt><rdf:li xml:lang='x-default'>Objetivo. Analizar los mecanismos de compensacion fisiologica y los limites de reserva ante la hipoxia moderada en canidos y felidos durante el transporte aereo comercial. Metodo. Revision tecnica de la fisiologia respiratoria comparada, principios de fisica de gases (Ley de Boyle, Ley de Dalton), normativa FAA/EASA/LAR sobre presurizacion de cabina y evidencia disponible sobre respuesta fisiologica en vuelo. Resultados. La presurizacion de cabina comercial equivale a altitudes de 1.800-2.400 m,</rdf:li></rdf:Alt></dc:description>
      <dc:publisher><rdf:Bag><rdf:li>Zoovet Travel</rdf:li></rdf:Bag></dc:publisher>
      <dc:language><rdf:Bag><rdf:li>es</rdf:li></rdf:Bag></dc:language>
      <dc:subject><rdf:Bag><rdf:li>hipoxia moderada, transporte aereo mascotas, braquicefalos, presurizacion cabina, PiO2, fisiologia respiratoria comparada, FAA, EASA, bienestar animal en vuelo</rdf:li></rdf:Bag></dc:subject>
      <xmp:CreateDate>2026-05-24</xmp:CreateDate>
      <xmp:CreatorTool>Zoovet Travel Academic PDF Generator</xmp:CreatorTool>
      <prism:doi>10.5281/zenodo.20361607</prism:doi>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
